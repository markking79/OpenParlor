#!/usr/bin/env bash
# Runs one bounded local Qwen/Aider implementation pass. Codex remains the
# supervisor: it writes the task card, reviews the diff, validates, commits,
# and pushes. The worker never performs those actions.
set -euo pipefail

REPO="${OPENPARLOR_REPO:-$PWD}"
MODE="${1:---resume}"
CHECK_ONLY="${2:-}"
TMP="${OPENPARLOR_SUPERVISOR_TMP:-/tmp/openparlor-supervisor}"
AIDER_BIN="${AIDER_BIN:-/home/mark/.local/bin/aider}"
QWEN_BASE="${OPENPARLOR_QWEN_BASE:-http://127.0.0.1:8080/v1}"
QWEN_KEY="${OPENPARLOR_QWEN_KEY:-local}"
QWEN_MODEL="${OPENPARLOR_QWEN_MODEL:-openai/local}"
WORKER_PID_FILE="$TMP/worker.pid"
WORKER_PGID_FILE="$TMP/worker.pgid"

die() { echo "ERROR: $*" >&2; exit 1; }
[[ "$MODE" == '--resume' || "$MODE" == '--auto' ]] || die 'usage: openparlor-codex [--resume|--auto] [--check-only]'
[[ -d "$REPO/.git" ]] || die "not an OpenParlor checkout: $REPO"
[[ -x "$AIDER_BIN" ]] || die "Aider unavailable at $AIDER_BIN"
mkdir -p "$TMP"
cd "$REPO"

clear_stale_worker() {
    if [[ -f "$WORKER_PID_FILE" ]] && ! kill -0 "$(<"$WORKER_PID_FILE")" 2>/dev/null; then
        rm -f "$WORKER_PID_FILE" "$WORKER_PGID_FILE"
    fi
}
clear_stale_worker
if [[ -f "$WORKER_PID_FILE" ]] && kill -0 "$(<"$WORKER_PID_FILE")" 2>/dev/null; then
    die "launcher-owned worker is active (PID $(<"$WORKER_PID_FILE"), PGID $(<"$WORKER_PGID_FILE" 2>/dev/null || true))"
fi

mapfile -t files < <(sed -n '/^## \(Exact \)\?[Aa]llowlist/,/^## /p' .agent/current-task.md | sed -n 's/^- `\([^`]*\)`.*/\1/p' | sed 's/ (new)$//' | grep -E '^(src|public|tests)/' || true)
TASK_ID="$(sed -n '1{s/^# *\(TASK-[A-Z0-9-]*\).*/\1/p;}' .agent/current-task.md)"
[[ -n "$TASK_ID" && ${#files[@]} -gt 0 ]] || die 'current task card needs a task ID and parseable production/test allowlist'

printf 'OPENPARLOR — %s\n' "$TASK_ID"
printf 'allowed worker files: %s\n' "${files[*]}"
if [[ "$CHECK_ONLY" == '--check-only' ]]; then
    [[ "$MODE" == '--resume' ]] || die '--check-only is only supported with --resume'
    echo 'Worker launch: DISABLED'
    exit 0
fi
[[ -z "$CHECK_ONLY" ]] || die 'use --resume --check-only'

cleanup_worker() {
    local pid pgid
    [[ -f "$WORKER_PID_FILE" ]] || return 0
    pid="$(<"$WORKER_PID_FILE")"
    pgid="$(<"$WORKER_PGID_FILE" 2>/dev/null || true)"
    if kill -0 "$pid" 2>/dev/null; then
        kill -TERM -- "-$pgid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    fi
    rm -f "$WORKER_PID_FILE" "$WORKER_PGID_FILE"
}
trap cleanup_worker EXIT INT TERM

prompt="You are the implementation worker for $TASK_ID. Read .agent/current-task.md and the existing diff. Implement only the current task and edit ONLY these files: ${files[*]}. Preserve all unrelated dirty work. Do not edit .agent files, commit, push, stage, reset, clean, or discard work. Inspect relevant source first; run focused tests if possible. At completion report changed files, checks run, and concerns."
setsid env OPENAI_API_BASE="$QWEN_BASE" OPENAI_API_KEY="$QWEN_KEY" timeout --signal=INT --kill-after=30s 15m "$AIDER_BIN" "${files[@]}" --model "$QWEN_MODEL" --edit-format diff --map-tokens 0 --no-auto-commits --no-show-model-warnings --no-gitignore --yes --message "$prompt" &
pid=$!
pgid="$(ps -o pgid= -p "$pid" | tr -d ' ')"
printf '%s\n' "$pid" > "$WORKER_PID_FILE"
printf '%s\n' "$pgid" > "$WORKER_PGID_FILE"
echo "worker PID: $pid PGID: $pgid"

status=0
while kill -0 "$pid" 2>/dev/null; do
    sleep 20
    kill -0 "$pid" 2>/dev/null && echo "Qwen worker active: PID $pid PGID $pgid"
done
wait "$pid" || status=$?
if pgrep -g "$pgid" >/dev/null 2>&1; then
    die "launcher-owned worker group $pgid did not exit; preserving work"
fi
rm -f "$WORKER_PID_FILE" "$WORKER_PGID_FILE"
trap - EXIT INT TERM
echo "worker exit: $status (Codex must review and validate preserved work)"
exit "$status"
